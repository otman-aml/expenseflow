# ============================================================
# Fichier d'EXEMPLE des variables d'environnement.
#
#   cp .env.example .env   puis remplir les valeurs.
#
# Ce fichier est COMMITÉ : il documente les variables sans porter
# de valeur. Le fichier .env obtenu est IGNORÉ par Git.
#
# ⚠ DEUX LIGNES SONT OBLIGATOIRES : GROQ_API_KEY et JWT_SECRET.
#   Sans elles, `docker compose up` REFUSE de démarrer et nomme la
#   variable fautive. C'est voulu : aucun secret ne figure en dur
#   dans docker-compose.yml, qui est commité.
# ============================================================

# --- Brique IA -------------------------------------------------------
# Clé API Groq, obligatoire pour l'extraction de dépense.
# Gratuite : https://console.groq.com/keys
#
# ⚠ OBLIGATOIRE. Sans elle, `docker compose up` refuse de démarrer.
# (Ce comportement est plus strict que celui de l'application seule, qui
# démarrerait normalement et renverrait 503 à l'extraction. La cohérence
# de la pile prime : on préfère le découvrir au lancement plutôt qu'au
# milieu d'une démonstration.)
GROQ_API_KEY=

# --- Sécurité --------------------------------------------------------
# Secret de signature des jetons JWT (HS256).
# 64 caractères hexadécimaux minimum.
#
#   openssl rand -hex 32
#
# ⚠ OBLIGATOIRE. Sans lui, `docker compose up` refuse de démarrer.
#
# Jamais commité, jamais réutilisé d'un environnement à l'autre :
# cette valeur permet de fabriquer un jeton pour n'importe quel compte.
JWT_SECRET=

# --- Base de données -------------------------------------------------
# Mot de passe du PostgreSQL local (celui de docker-compose.yml).
# Les deux doivent correspondre.
DB_PASSWORD=expenseflow

# --- CORS ------------------------------------------------------------
# Origine(s) autorisée(s) à appeler l'API, séparées par des virgules.
# En production, remplacer par le domaine réel du front, sans barre
# oblique finale.
CORS_ALLOWED_ORIGINS=http://localhost:4300
